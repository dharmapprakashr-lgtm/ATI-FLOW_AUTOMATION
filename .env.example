# Copy this file to .env and fill in real values. .env is gitignored.
#   cp .env.example .env
#
# Only the variables listed here are read (see config/environment.py).
# The requester / dispatcher / supervisor dashboards do NOT use env vars:
# they log in with the device Name + Password from config/test_data.toml.

# ── Required ──────────────────────────────────────────────────────────────────

# Full URL of the login page, including the /login path.
BASE_URL=https://192.168.6.32/login

# Admin account. Everything the suite builds is created through this account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Optional ──────────────────────────────────────────────────────────────────

# MES is the one role backed by a real user account rather than a device record.
# Only needed if you run tests that use the mes_page fixture.
MES_USERNAME=mes_user
MES_PASSWORD=mes_pass

# false = watch the browser while tests run. Handy when debugging.
HEADLESS=True

# Which config/environments/<name>.yaml to load. Defaults to qa.
# TEST_ENV=qa

# Default Playwright wait for the app to settle, in milliseconds.
# DEFAULT_TIMEOUT=15000
